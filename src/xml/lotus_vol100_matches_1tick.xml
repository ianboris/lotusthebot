<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="http://www.w3.org/1999/xhtml" collection="false" is_dbot="true">
  <variables>
    <variable type="" id="lotus_session_pnl" islocal="false" iscloud="false">Lotus Session PnL</variable>
  </variables>
  <block type="trade_definition" id="lotus_trade_definition" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="lotus_market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="lotus_trade_type" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">matchesdiffers</field>
            <next>
              <block type="trade_definition_contracttype" id="lotus_contract_type" deletable="false" movable="false">
                <field name="TYPE_LIST">DIGITMATCH</field>
                <next>
                  <block type="trade_definition_candleinterval" id="lotus_candle_interval" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="lotus_restart_buy_sell" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="lotus_restart_on_error" deletable="false" movable="false">
                            <field name="RESTARTONERROR">FALSE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="lotus_init_session_pnl">
        <field name="VAR" id="lotus_session_pnl" variabletype="">Lotus Session PnL</field>
        <value name="VALUE">
          <block type="math_number" id="lotus_init_zero">
            <field name="NUM">0</field>
          </block>
        </value>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="lotus_trade_options">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">AUD</field>
        <value name="DURATION" strategy_value="duration">
          <shadow type="math_number" id="lotus_duration">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="lotus_stake">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number_positive" id="lotus_prediction">
            <field name="NUM">5</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="lotus_before_purchase" x="0" y="620">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="lotus_purchase_matches">
        <field name="PURCHASE_LIST">DIGITMATCH</field>
      </block>
    </statement>
  </block>
  <block type="after_purchase" id="lotus_after_purchase" x="650" y="620">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="lotus_update_session_pnl">
        <field name="VAR" id="lotus_session_pnl" variabletype="">Lotus Session PnL</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="lotus_add_contract_profit">
            <field name="OP">ADD</field>
            <value name="A">
              <block type="variables_get" id="lotus_get_session_pnl">
                <field name="VAR" id="lotus_session_pnl" variabletype="">Lotus Session PnL</field>
              </block>
            </value>
            <value name="B">
              <block type="read_details" id="lotus_read_contract_profit">
                <field name="DETAIL_INDEX">4</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="controls_if" id="lotus_session_guard">
            <value name="IF0">
              <block type="logic_operation" id="lotus_session_and">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="logic_compare" id="lotus_loss_limit_check">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="variables_get" id="lotus_loss_pnl">
                        <field name="VAR" id="lotus_session_pnl" variabletype="">Lotus Session PnL</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="lotus_loss_limit">
                        <field name="NUM">-1</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare" id="lotus_profit_limit_check">
                    <field name="OP">LT</field>
                    <value name="A">
                      <block type="variables_get" id="lotus_profit_pnl">
                        <field name="VAR" id="lotus_session_pnl" variabletype="">Lotus Session PnL</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="lotus_profit_limit">
                        <field name="NUM">2</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="trade_again" id="lotus_trade_again"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
